# Copy to .env (and to .env.test for e2e tests) and adjust values.

# Backend
PORT=3000
DATABASE_URL=postgresql://atlas:atlas@localhost:5432/atlas
DATABASE_URL_TEST=postgresql://atlas:atlas@localhost:5433/atlas_test
JWT_ACCESS_SECRET=change_me
JWT_REFRESH_SECRET=change_me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
FRONTEND_ORIGIN=http://localhost:5173
# Max login/register/refresh requests per minute per IP and route (brute-force protection)
THROTTLE_AUTH_LIMIT=10
SEED_ADMIN_EMAIL=admin@atlas.local
SEED_ADMIN_PASSWORD=Admin12345
SEED_DEMO_EMAIL=demo@atlas.local
SEED_DEMO_PASSWORD=Demo12345
OPEN_LIBRARY_BASE_URL=https://openlibrary.org

# Frontend (Vite exposes only VITE_* variables to the client)
VITE_API_URL=http://localhost:3000/api
